# Multi-stage production Dockerfile for React Frontend
# Stage 1: Build the React app
FROM node:22-alpine AS builder

WORKDIR /app

# Copy package files
COPY frontend/package*.json ./

# Install dependencies (use clean install for reproducible builds)
RUN npm ci --production=false

# Copy source code
COPY frontend/ ./

# Build the production bundle
# Vite will use .env.production for environment variables
RUN npm run build

# Stage 2: Serve with Nginx
FROM nginx:alpine

# Remove default nginx config
RUN rm -rf /etc/nginx/conf.d/*

# Copy built assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx configuration (use production config)
COPY nginx/conf.d/production.conf /etc/nginx/conf.d/default.conf

# Add labels for documentation
LABEL maintainer="Azure Migration Tool"
LABEL description="Production frontend for Azure Migration Tool"
LABEL version="4.0.0-mvp"

# Expose port 80
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
