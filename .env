# Development Environment Variables
# Copy this file to .env and update with your values

# Database Configuration
DB_PASSWORD=azmig_secure_password_change_me

# Redis Configuration
REDIS_PASSWORD=redis_secure_password_change_me

# API Security - IMPORTANT: Change these in production!
SECRET_KEY=your-super-secret-key-min-32-characters-please-change-this
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Azure Configuration (Optional - can be configured per-project)
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Application Environment
ENVIRONMENT=development
DEBUG=true
